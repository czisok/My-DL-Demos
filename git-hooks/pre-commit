#!/bin/bash

# ====================== 配置项 ======================
MAX_FILE_SIZE=$((20 * 1024 * 1024))
SKIP_SUFFIX=".gitignore .md .txt"
# ====================================================

has_big_file=0

# 进程替换 < <() ，保留NULL分隔符，不走子shell，不丢失\0
while IFS= read -r -d '' f
do
    [[ -z "$f" ]] && continue
    if [[ ! -e "$f" ]]; then
        continue
    fi

    skip=0
    for suf in $SKIP_SUFFIX
    do
        if [[ "$f" == *"$suf" ]];then
            skip=1
            break
        fi
    done
    [[ $skip -eq 1 ]] && continue

    # stat兼容 Linux(GNU) / Mac(BSD)
    if stat --version 2>/dev/null | grep -q "GNU coreutils"; then
        filesize=$(stat -c%s "$f")
    else
        filesize=$(stat -f%z "$f")
    fi

    if (( filesize > MAX_FILE_SIZE )); then
        size_mb=$(( filesize / 1024 / 1024 ))
        echo "######################################################################"
        printf "❌ 拒绝提交：文件【%s】过大！大小 %dMB，最大允许 %dMB\n" "$f" "$size_mb" $((MAX_FILE_SIZE/1024/1024))
        echo "👉 不要把大模型、数据集、压缩包提交进git！"
        echo "👉 请把该文件加入 .gitignore，使用rsync/scp单独传输文件"
        echo "######################################################################"
        has_big_file=1
    fi

done < <(git diff --cached --name-only --diff-filter=ACM -z)


if (( has_big_file )); then
    echo
    echo "🔴 commit终止，请处理上面的大文件后再提交"
    exit 1
fi

exit 0
